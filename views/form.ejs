<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>

    <div class="page-content">

        <div class="form-div">
            <h1>New Message</h1>

            <form method="POST" action="/messages/new" autocomplete="off">
                <label for="messageUser">Name:</label>
                <input type="text" id="messageUser" name="messageUser" required>

                <label for="messageText">Message:</label>
                <textarea id="messageText" name="messageText" required></textarea>

                <button>Send</button>
            </form>
        </div>
        
    </div>
    
    <%- include ('./partials/nav.ejs') %>

</body>
</html>