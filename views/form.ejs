<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>

    <div class="page-content">
        <h1>New Message</h1>

        <form method="POST" action="/messages/new">
            <label for="messageUser">Name:</label>
            <input type="text" id="messageUser" name="messageUser" required>

            <label for="messageText">Message:</label>
            <textarea id="text" name="messageText" required></textarea>

            <button>Send</button>
        </form>
    </div>
    
    <%- include ('./partials/nav.ejs') %>

</body>
</html>