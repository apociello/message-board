<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
    <%- include ('./partials/nav.ejs') %>
    
    <div class="page-content">
        <h1>Messages</h1>

        <% if (messages.length > 0) { %>
            <% messages.forEach((message) => { %>
                <p><%= message.user %>: <%= message.text %></p>
                <a href="/messages/<%= message.message_id %>">details</a>
        <% }) %>

        <% } else { %>
            <p>No messages</p>
        <% } %>
    </div>
    
</body>
</html>