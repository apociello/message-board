<!DOCTYPE html>
<html lang="en">
<%- include('./partials/head.ejs') %>

<body>
    <h1>Messages</h1>

    <% if (messages.length > 0) { %>
        <% messages.forEach((message) => { %>
            <p><%= message.added %> - <%= message.user %>: <%= message.text %></p>
       <% }) %>

    <% } else { %>
        <p>No messages</p>
    <% } %>
</body>
</html>